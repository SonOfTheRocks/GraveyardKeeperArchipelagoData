{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SonOfTheRocks/GraveyardKeeperArchipelagoData/schemas/client-contract.schema.json",
  "title": "Graveyard Keeper Archipelago client contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_hash", "game", "items", "locations"],
  "properties": {
    "schema_version": {"const": 1},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "game": {"const": "Graveyard Keeper"},
    "items": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^ITEM_[A-Za-z0-9_]+$"},
      "additionalProperties": {"$ref": "#/$defs/item"}
    },
    "locations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^LOCATION_[A-Za-z0-9_]+$"},
      "additionalProperties": {"$ref": "#/$defs/location"}
    }
  },
  "$defs": {
    "dlc": {
      "enum": ["BASE_GAME", "STRANGER_SINS", "GAME_OF_CRONE", "BETTER_SAVE_SOUL"]
    },
    "nonEmptyString": {"type": "string", "minLength": 1},
    "stringArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"},
      "uniqueItems": true
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/stringArray"}
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dlc", "classification", "amount", "grant"],
      "properties": {
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "dlc": {"$ref": "#/$defs/dlc"},
        "classification": {"enum": ["PROGRESSION", "USEFUL", "FILLER", "TRAP"]},
        "amount": {"type": "integer", "minimum": 1},
        "grant": {"$ref": "#/$defs/grant"}
      }
    },
    "grant": {
      "oneOf": [
        {"$ref": "#/$defs/gameItemGrant"},
        {"$ref": "#/$defs/craftUnlockGrant"},
        {"$ref": "#/$defs/progressiveCraftUnlockGrant"},
        {"$ref": "#/$defs/workUnlockGrant"},
        {"$ref": "#/$defs/progressiveWorkUnlockGrant"},
        {"$ref": "#/$defs/perkUnlockGrant"},
        {"$ref": "#/$defs/permanentBuffGrant"},
        {"$ref": "#/$defs/relationGrant"},
        {"$ref": "#/$defs/researchPointsGrant"},
        {"$ref": "#/$defs/technologyUnlockGrant"},
        {"$ref": "#/$defs/flowScriptGrant"}
      ]
    },
    "gameItemGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "item_id"],
      "properties": {"type": {"const": "game_item"}, "item_id": {"$ref": "#/$defs/nonEmptyString"}}
    },
    "craftUnlockGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "craft_ids"],
      "properties": {"type": {"const": "craft_unlock"}, "craft_ids": {"$ref": "#/$defs/stringArray"}}
    },
    "progressiveCraftUnlockGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "stages"],
      "properties": {"type": {"const": "progressive_craft_unlock"}, "stages": {"$ref": "#/$defs/stages"}}
    },
    "workUnlockGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "work_ids", "perk_ids"],
      "properties": {
        "type": {"const": "work_unlock"},
        "work_ids": {"$ref": "#/$defs/stringArray"},
        "perk_ids": {"$ref": "#/$defs/stringArray"}
      }
    },
    "progressiveWorkUnlockGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "stages"],
      "properties": {"type": {"const": "progressive_work_unlock"}, "stages": {"$ref": "#/$defs/stages"}}
    },
    "perkUnlockGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "perk_id", "craft_ids", "work_ids"],
      "properties": {
        "type": {"const": "perk_unlock"},
        "perk_id": {"$ref": "#/$defs/nonEmptyString"},
        "craft_ids": {"$ref": "#/$defs/stringArray"},
        "work_ids": {"$ref": "#/$defs/stringArray"}
      }
    },
    "permanentBuffGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "buff_id", "resource_types", "icon"],
      "properties": {
        "type": {"const": "permanent_buff"},
        "buff_id": {"$ref": "#/$defs/nonEmptyString"},
        "resource_types": {"$ref": "#/$defs/stringArray"},
        "icon": {"type": "string"}
      }
    },
    "relationGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "npc_id", "amount"],
      "properties": {
        "type": {"const": "relation"},
        "npc_id": {"$ref": "#/$defs/nonEmptyString"},
        "amount": {"type": "integer", "minimum": 1}
      }
    },
    "researchPointsGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "color", "amount"],
      "properties": {
        "type": {"const": "research_points"},
        "color": {"enum": ["red", "green", "blue"]},
        "amount": {"type": "integer", "minimum": 1}
      }
    },
    "technologyUnlockGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "technology_ids"],
      "properties": {"type": {"const": "technology_unlock"}, "technology_ids": {"$ref": "#/$defs/stringArray"}}
    },
    "flowScriptGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "script_id"],
      "properties": {"type": {"const": "flow_script"}, "script_id": {"$ref": "#/$defs/nonEmptyString"}}
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dlc", "parent_region", "triggers"],
      "properties": {
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "dlc": {"$ref": "#/$defs/dlc"},
        "parent_region": {"$ref": "#/$defs/nonEmptyString"},
        "triggers": {
          "type": "array",
          "items": {"$ref": "#/$defs/trigger"},
          "uniqueItems": true
        }
      }
    },
    "trigger": {
      "oneOf": [
        {"$ref": "#/$defs/flowQuestTrigger"},
        {"$ref": "#/$defs/flowRelationTrigger"},
        {"$ref": "#/$defs/craftTrigger"},
        {"$ref": "#/$defs/technologyTrigger"},
        {"$ref": "#/$defs/worldItemTrigger"}
      ]
    },
    "flowQuestTrigger": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "graph", "node_id"],
      "properties": {
        "type": {"const": "flow_quest_reward"},
        "graph": {"$ref": "#/$defs/nonEmptyString"},
        "node_id": {"$ref": "#/$defs/nonEmptyString"},
        "answer_index": {"type": "integer", "minimum": 0}
      }
    },
    "flowRelationTrigger": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "graph", "node_id"],
      "properties": {
        "type": {"const": "flow_relation_reward"},
        "graph": {"$ref": "#/$defs/nonEmptyString"},
        "node_id": {"$ref": "#/$defs/nonEmptyString"},
        "answer_index": {"type": "integer", "minimum": 0}
      }
    },
    "craftTrigger": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "craft_id"],
      "properties": {"type": {"const": "craft_reward"}, "craft_id": {"$ref": "#/$defs/nonEmptyString"}}
    },
    "technologyTrigger": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "technology_id"],
      "properties": {"type": {"const": "technology_reward"}, "technology_id": {"$ref": "#/$defs/nonEmptyString"}}
    },
    "worldItemTrigger": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "item_id"],
      "properties": {"type": {"const": "world_item_reward"}, "item_id": {"$ref": "#/$defs/nonEmptyString"}}
    }
  }
}
